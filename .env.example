# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Overrides the Gemini model used by the pipeline.
# Defaults to "gemini-3.1-flash-lite" (recommended stable model for free tier, year 2026+).
# Other options: "gemini-3-flash-preview" (stronger), "gemini-flash-latest" (auto-latest).
# GEMINI_MODEL="gemini-3.1-flash-lite"

# ADMIN_TOKEN: Secret token used to authenticate hidden admin sync requests (/api/admin/sync)
ADMIN_TOKEN="hush_admin_secret_token_2026"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

